# ===============================
# Impulso REP - Entorno local / Koyeb + Neon
# ===============================

# OPCIÓN RECOMENDADA PARA NEON:
# Copia aquí el connection string de Neon.
# Debe quedar solo en backend o en Koyeb, nunca en el frontend.
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST/neondb?sslmode=require
DATABASE_SSL=true

# Puerto del backend. Koyeb puede inyectar PORT automáticamente.
PORT=3000

# Secreto de sesión o firma interna. Cambiar en producción.
SESSION_SECRET=impulsorep_cambiar_en_produccion

# Inicializa la base automáticamente al arrancar si aún no existen tablas.
# En producción puede quedar true para el primer deploy.
DATABASE_INIT=true

# OPCIÓN LOCAL SIN NEON, si usas PostgreSQL instalado en tu PC:
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu_clave
# DB_NAME=ley_rep
# DATABASE_SSL=false
